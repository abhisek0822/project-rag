# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL + pgvector (the host value works when running Docker Compose)
DATABASE_URL=postgresql+psycopg://rag:rag@postgres:5432/rag
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Queue
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# Original file storage. Use "local" outside Docker if MinIO is not wanted.
BLOB_STORE=minio
LOCAL_BLOB_PATH=./data/blobs
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=ragminio
S3_SECRET_KEY=ragminiosecret
S3_BUCKET=rag-documents
S3_REGION=us-east-1
S3_SECURE=false

# Keyless defaults exercise the complete pipeline locally. For higher-quality
# question answering, use this OpenAI profile after adding a key:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# GENERATION_PROVIDER=openai
# GENERATION_MODEL=gpt-5.6-luna
# GENERATION_REASONING_EFFORT=none
OPENAI_API_KEY=
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=feature-hash-v1
EMBEDDING_DIMENSIONS=1536
GENERATION_PROVIDER=extractive
GENERATION_MODEL=extractive-v1
GENERATION_REASONING_EFFORT=none

# Ingestion and retrieval tuning
MAX_UPLOAD_BYTES=52428800
CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=750
CHUNK_MIN_TOKENS=100
CHUNK_OVERLAP_TOKENS=75
DENSE_CANDIDATE_LIMIT=40
LEXICAL_CANDIDATE_LIMIT=40
RERANK_CANDIDATE_LIMIT=30
CONTEXT_CHUNK_LIMIT=8
CONTEXT_TOKEN_BUDGET=6000
